<?xml version="1.0" encoding="utf-8"?>
<resources>
  <style name="AppTheme" parent="android:Theme.DeviceDefault.NoActionBar">
    <item name="android:windowBackground">@color/bg</item>
    <item name="android:statusBarColor">@color/bg</item>
    <item name="android:navigationBarColor">@color/bg</item>
    <item name="android:colorAccent">#2F6BFF</item>
  </style>
  <style name="ShareTheme" parent="android:Theme.DeviceDefault.NoActionBar">
    <item name="android:windowIsTranslucent">true</item>
    <item name="android:windowBackground">@android:color/transparent</item>
    <item name="android:windowNoTitle">true</item>
    <item name="android:backgroundDimEnabled">true</item>
    <item name="android:windowAnimationStyle">@null</item>
    <item name="android:colorAccent">#2F6BFF</item>
  </style>
  <style name="BeamDialogAnim">
    <item name="android:windowEnterAnimation">@anim/beam_dialog_in</item>
    <item name="android:windowExitAnimation">@anim/beam_dialog_out</item>
  </style>
  <style name="BeamDialog" parent="android:Theme.DeviceDefault.Dialog.Alert">
    <item name="android:windowAnimationStyle">@style/BeamDialogAnim</item>
    <item name="android:colorAccent">#5CC8FF</item>
  </style>
  <color name="bg">#0f1626</color>
</resources>
