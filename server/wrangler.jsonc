{
  "name": "beam",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  // The web app (copied here from ../web by the deploy workflow)
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // Files sent from the iPhone Shortcut wait here until the device has them (at most a day).
  "r2_buckets": [{ "binding": "INBOX", "bucket_name": "beam-inbox" }],
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "Hub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  "version_metadata": { "binding": "VERSION" },
  "observability": { "enabled": true }
}
